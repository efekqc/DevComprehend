{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcomprehend.io/schemas/v1/message.schema.json",
  "title": "DevComprehend Message Schema",
  "description": "JSON Schema for DevComprehend events including requests, queued statuses, analysis results, and evaluations.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "v1.0.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "analysis.request",
        "analysis.queued",
        "analysis.ready",
        "answer.request",
        "evaluation.result"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "event_type",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false
}
