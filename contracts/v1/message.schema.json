{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcomprehend.io/schemas/v1/message.schema.json",
  "title": "DevComprehend Message Schema",
  "description": "JSON Schema for DevComprehend events including requests, queued statuses, analysis results, and evaluations.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "v1.0.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "analysis.request",
        "analysis.queued",
        "analysis.ready",
        "answer.request",
        "evaluation.result"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "event_type",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "analysis_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "repository_id",
        "base_commit_sha",
        "snapshot_id",
        "scope",
        "diff",
        "context",
        "pipeline_version"
      ],
      "properties": {
        "kind": {
          "const": "analysis_request"
        },
        "contract_version": {
          "const": "1"
        },
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "base_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "enum": [
            "staged",
            "unstaged"
          ]
        },
        "diff": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "id",
        "status",
        "questions",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "analysis_result"
        },
        "contract_version": {
          "const": "1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "fetching",
            "generating",
            "ready",
            "failed"
          ]
        },
        "questions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "concept",
              "prompt",
              "sources",
              "rubric"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "concept": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "start_line",
                    "end_line",
                    "snapshot_id"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "snapshot_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "rubric": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 3
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "answer_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "question_id",
        "answer",
        "submission_id"
      ],
      "properties": {
        "kind": {
          "const": "answer_request"
        },
        "contract_version": {
          "const": "1"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "submission_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "question_id",
        "assessment_state",
        "rubric_results",
        "feedback",
        "uncertain",
        "due_at"
      ],
      "properties": {
        "kind": {
          "const": "evaluation_result"
        },
        "contract_version": {
          "const": "1"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_state": {
          "enum": [
            "unassessed",
            "developing",
            "demonstrated"
          ]
        },
        "rubric_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "result"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "met",
                  "partial",
                  "missing"
                ]
              }
            }
          }
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "uncertain": {
          "type": "boolean"
        },
        "due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}