# ─── DevComprehend Local Environment ───────────────────────────────
# Copy this file to .env and adjust values as needed.
# NEVER commit the actual .env file.

# ─── Database ──────────────────────────────────────────────────────
DB_PORT=5433
POSTGRES_DB=devcomprehend
POSTGRES_USER=dc_admin
POSTGRES_PASSWORD=dc_local_pass_2026
DATABASE_URL=postgresql://dc_admin:dc_local_pass_2026@localhost:5433/devcomprehend

# ─── Redis (Sliding Window Rate Limiter) ───────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_WINDOW_SECONDS=86400
RATE_LIMIT_MAX_ANALYSES=10
RATE_LIMIT_MAX_EVALUATIONS=30

# ─── LLM Provider ─────────────────────────────────────────────────
# In local/CI, always use the fake provider to avoid real API calls.
ENABLE_FAKE_LLM_PROVIDER=true
LLM_API_BASE_URL=http://localhost:8080/v1
# Real keys are NEVER stored here; they live in backend KMS.
# LLM_API_KEY=  ← intentionally left blank

# ─── Budget & Quota ───────────────────────────────────────────────
TOKEN_QUOTA_PER_DAY=50000
MAX_ANALYSES_PER_DAY=10
MAX_EVALUATIONS_PER_DAY=30
COST_ALERT_THRESHOLD_USD=5.00

# ─── Application ──────────────────────────────────────────────────
LOG_LEVEL=debug
NODE_ENV=development
